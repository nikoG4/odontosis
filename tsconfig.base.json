{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@odontosis/types": [
        "packages/types/src"
      ],
      "@odontosis/config": [
        "packages/config/src"
      ]
    }
  }
}
