# Oracle
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
ORACLE_WALLET_DIR=./oracle-wallet
ORACLE_WALLET_PASSWORD=

# JWT - generate long random values locally; never copy secrets from documentation.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Backend
PORT=3001

# Local frontend/app URLs
VITE_API_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_WEB_URL=http://localhost:5173

# Google OAuth client IDs
# Obtain these from your own Google Cloud project / OAuth configuration.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
