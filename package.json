{
  "name": "odontosis",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @odontosis/api",
    "dev:web": "npm run dev --workspace @odontosis/web",
    "dev:app": "npm run dev --workspace @odontosis/app",
    "dev:app:web": "npm run web --workspace @odontosis/app",
    "build": "npm run build --workspaces",
    "db:migrate": "npm run db:init --workspace @odontosis/api",
    "db:seed": "npm run db:seed --workspace @odontosis/api"
  }
}
